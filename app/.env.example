# Supabase → Project Settings → API (or Connect → App Frameworks → Next.js)
# Both are safe to expose to the browser: access is enforced by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Leave both empty to keep using the dummy data in lib/mock-data.ts.

# Server-only (never prefix with NEXT_PUBLIC_). Used by /api/watch to stream readings to watch links.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Signs watch links (QR on /device). Generate with: openssl rand -hex 32. Changing it revokes every link.
DEVICE_TOKEN_SECRET=
